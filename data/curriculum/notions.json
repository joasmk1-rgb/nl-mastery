  "niet_vs_geen": {
    "level": "A1",
    "module": "a1-m8",
    "skills": [
      "grammaire"
    ],
    "prerequisites": [
      "niet",
      "geen"
    ],
    "status": "pret",
    "content": {
      "objectif": "Savoir choisir entre 'niet' et 'geen' pour nier une phrase néerlandaise.",
      "comprendre": "'Geen' nie un nom précédé de 'een' (un/une) ou sans article ; 'niet' nie tout le reste (un verbe, un adjectif, un nom déjà défini par 'de'/'het', un lieu, une heure...).",
      "regle": "Nom indéfini ou non compté → geen. Tout le reste → niet. 'Niet' se place généralement en fin de proposition, sauf devant un adjectif, une préposition ou un complément de lieu précis, où il se place juste avant.",
      "exemples": [
        "Ik heb geen tijd. (pas de temps, nom indéfini)",
        "Ik ga niet naar Brussel. (niet + lieu précis)",
        "Dit is niet duur. (niet + adjectif)",
        "Ik heb de sleutels niet. (nom déjà défini par 'de' → niet)"
      ],
      "erreursFrequentes": [
        "Utiliser 'niet' devant un nom indéfini sans article ('Ik heb niet tijd' au lieu de 'geen tijd').",
        "Placer 'niet' n'importe où dans la phrase sans respecter sa position par rapport au mot qu'il nie."
      ]
    },
    "exerciseIds": [
      "ex_niet_geen_qcm1",
      "ex_niet_geen_trous1"
    ]
  },
