  "de_het": {
    "level": "A1",
    "module": "a1-m3",
    "skills": [
      "grammaire",
      "vocabulaire"
    ],
    "prerequisites": [],
    "status": "pret",
    "content": {
      "objectif": "Savoir choisir le bon article (de/het) devant un nom néerlandais et le retenir avec le mot.",
      "comprendre": "Contrairement au français qui a 'le/la', le néerlandais a deux genres grammaticaux fusionnés en 'de' (environ 2/3 des noms, dont tous les pluriels) et 'het' (environ 1/3, souvent les diminutifs et les mots empruntés au latin en -um/-a/-ma).",
      "regle": "L'article se retient MOT PAR MOT, il n'y a pas de règle fiable à 100%. Quelques tendances utiles : tous les diminutifs (-je) prennent 'het' ; tous les pluriels prennent 'de' ; les noms de langues et de métaux prennent 'het'.",
      "exemples": [
        "de tafel (la table)",
        "het huis (la maison)",
        "het meisje (la fille, diminutif)",
        "de tafels (les tables, pluriel → de)"
      ],
      "erreursFrequentes": [
        "Vouloir déduire l'article depuis le français ('la maison' → 'de huis' est faux, c'est 'het huis').",
        "Oublier qu'un pluriel est toujours 'de', même si le singulier était 'het'."
      ]
    },
    "exerciseIds": [
      "ex_dehet_qcm1",
      "ex_dehet_qcm2"
    ]
  },
