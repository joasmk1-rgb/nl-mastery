rules_version = '2';

// ==========================================================================================
// Règles de sécurité Firestore — NL Mastery
// À coller intégralement dans Firebase Console → Firestore Database → Règles, puis "Publier".
//
// Portée : couvre les 9 collections utilisées par l'app aujourd'hui (progression pédagogique +
// couche sociale complète : amis, notifications, défis, sessions de travail). Avec
// `rules_version = '2'`, Firestore refuse par défaut tout accès à une collection sans règle
// explicite — donc toute future collection ajoutée plus tard (au-delà de ce qui existe
// aujourd'hui) restera automatiquement bloquée tant qu'elle n'aura pas sa propre règle ici.
// ==========================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Fonctions utilitaires -----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Lit le rôle de l'utilisateur courant dans users/{uid} — un get() interne aux règles n'est
    // jamais soumis aux règles de lecture de ce document (comportement standard Firestore), donc
    // ceci fonctionne même si l'utilisateur n'a par ailleurs pas le droit de lire le doc d'un autre.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Un seul id de relation par paire d'utilisateurs (toujours les deux uid triés, joints par
    // "_" — voir socialPairId côté client). Reproduit ici pour vérifier qu'un ami accepté peut
    // bien lire friendStats/{uid} sans jamais pouvoir lire la progression complète (users/{uid}).
    function friendPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isAcceptedFriendOf(otherUid) {
      let pid = friendPairId(request.auth.uid, otherUid);
      return isSignedIn() &&
        exists(/databases/$(database)/documents/friendships/$(pid)) &&
        get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'accepted';
    }

    // ================= users/{uid} — progression complète, PRIVÉE (jamais lue par un ami) =================
    match /users/{uid} {
      // get : le propriétaire OU un admin (panneau admin). list : admin uniquement (l'admin liste
      // tous les comptes via orderBy('pseudo') — aucune autre partie de l'app ne fait de liste ici).
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Création à l'inscription : uniquement son propre document, avec un rôle 'user' et un
      // compte activé — empêche un client malveillant de s'auto-promouvoir admin dès la création.
      allow create: if isOwner(uid) &&
        request.resource.data.role == 'user' &&
        request.resource.data.disabled == false;

      // Mise à jour : le propriétaire peut mettre à jour SA progression (synchro cloud à chaque
      // save()) mais ne peut jamais changer son propre rôle ni se réactiver lui-même s'il est
      // désactivé. Un admin peut tout modifier (désactiver un compte, réinitialiser la progression).
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.disabled == resource.data.disabled
      );

      allow delete: if false; // aucune fonctionnalité de suppression de compte pour l'instant
    }

    // ================= usernames/{pseudoLower} — mapping pseudo -> uid (existait déjà) =================
    match /usernames/{pseudoLower} {
      // Lecture publique nécessaire : (1) vérifier l'unicité d'un pseudo AVANT la création du
      // compte (l'utilisateur n'est pas encore authentifié à ce moment précis de l'inscription),
      // (2) la recherche d'amis par pseudo exact. Le document ne contient que {uid, discoverable}
      // — jamais d'email ni de donnée sensible — donc l'exposer en lecture n'est pas un risque.
      allow get: if true;
      allow list: if false; // empêche d'énumérer tous les pseudos existants

      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;

      // Seul le propriétaire du pseudo peut le modifier (bascule "discoverable"), et l'uid
      // associé ne peut jamais changer après coup.
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid;

      allow delete: if false;
    }

    // ================= publicProfiles/{uid} — identité publique minimale (pseudo uniquement) =================
    match /publicProfiles/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isOwner(uid) && request.resource.data.uid == uid;
    }

    // ================= friendStats/{uid} — SEUL sous-ensemble de progression partageable =================
    // Contient uniquement les champs que le propriétaire a choisi de publier (voir
    // socialComputeShareableStats côté client — la restriction se fait à l'écriture). Lisible par
    // le propriétaire et par ses amis acceptés uniquement — jamais par un inconnu, jamais la
    // progression complète de users/{uid}.
    match /friendStats/{uid} {
      allow get: if isOwner(uid) || isAcceptedFriendOf(uid);
      allow list: if false;
      allow write: if isOwner(uid); // seul le propriétaire publie ses propres statistiques
    }

    // ================= friendRequests/{pairId} — une demande par paire, jamais de doublon =================
    match /friendRequests/{pairId} {
      // Lisible par les deux personnes concernées (get direct, ou la requête
      // where('toUid','==',uid).where('status','==','pending') : Firestore applique cette règle à
      // chaque document renvoyé, donc la requête reste valide car toUid == request.auth.uid pour
      // tous les résultats possibles). `resource == null` : la plupart des paires d'utilisateurs
      // n'ont AUCUNE demande entre elles — sans ce cas, un simple .get() sur un document qui
      // n'existe pas encore (le cas le plus fréquent, testé à chaque recherche/ajout d'ami) serait
      // refusé par les règles au lieu de renvoyer "n'existe pas", et casserait l'app.
      allow read: if isSignedIn() && (resource == null ||
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      // On ne peut créer une demande qu'en son propre nom (fromUid = soi-même), à l'état 'pending'.
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Seul le destinataire (toUid) peut répondre (accepter/refuser).
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;

      allow delete: if false;
    }

    // ================= friendships/{pairId} — relation acceptée OU blocage, une par paire =================
    match /friendships/{pairId} {
      // `resource == null` : même raison que pour friendRequests ci-dessus — vérifier "sommes-nous
      // déjà amis ?" est l'opération la plus fréquente et porte, la plupart du temps, sur une paire
      // qui n'a encore aucune relation.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.uids);

      // Création : soit l'acceptation d'une demande (statut 'accepted', les deux personnes
      // impliquées existent déjà dans uids), soit un blocage direct (statut 'blocked', et c'est
      // bien l'auteur de la requête qui se déclare comme bloqueur).
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.uids && (
        request.resource.data.status == 'accepted' ||
        (request.resource.data.status == 'blocked' && request.resource.data.blockedBy == request.auth.uid)
      );

      // Mise à jour : uniquement pour bloquer quelqu'un (transition vers 'blocked' par soi-même).
      allow update: if isSignedIn() && request.auth.uid in resource.data.uids &&
        request.resource.data.status == 'blocked' &&
        request.resource.data.blockedBy == request.auth.uid;

      // Suppression : un ami accepté peut retirer l'amitié ; un blocage ne peut être levé que par
      // la personne qui l'a posé à l'origine.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids && (
        resource.data.status == 'accepted' ||
        (resource.data.status == 'blocked' && resource.data.blockedBy == request.auth.uid)
      );
    }

    // ================= notifications/{id} — visibles uniquement par leur destinataire =================
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;

      // On ne peut créer une notification qu'en indiquant soi-même comme expéditeur (empêche
      // d'usurper l'identité d'un autre utilisateur pour envoyer une fausse notification).
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;

      // Seul le destinataire peut marquer une notification comme lue — et uniquement ce champ.
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // ================= challenges/{id} — défi entre deux amis sur UNE notion existante =================
    // Id auto-généré (contrairement à friendships/friendRequests) : plusieurs défis successifs sont
    // légitimes entre les deux mêmes personnes, ce n'est pas une "relation" unique à dédupliquer.
    match /challenges/{id} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.fromCompleted == false &&
        request.resource.data.toCompleted == false;

      // Le destinataire répond (accepte/refuse) ; l'un ou l'autre peut ensuite marquer sa part
      // terminée (le client ne l'autorise que si getNotionStatus() confirme déjà la maîtrise —
      // les règles ne peuvent pas relire ce calcul, elles vérifient seulement qui écrit quoi) ou
      // annuler le défi.
      allow update: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow delete: if false;
    }

    // ================= studySessions/{id} — simple rendez-vous partagé (pas de sync temps réel) =================
    match /studySessions/{id} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow delete: if false;
    }
  }
}
